{
  "expo": {
    "name": "jabarin",
    "slug": "jabarin",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "jabarin",
    "userInterfaceStyle": "automatic",
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server"
    },
    "plugins": [
      "expo-router",
      ["expo-image-picker", {
        "photosPermission": "Izinkan JABARIN memilih foto bukti laporan.",
        "cameraPermission": "Izinkan JABARIN mengambil foto bukti laporan.",
        "microphonePermission": false
      }],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
